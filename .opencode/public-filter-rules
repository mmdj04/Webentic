# ─── Blacklist for public repo ───
# Files/directories matching these patterns are EXCLUDED from publish.
# Used by scripts/publish-public.sh via rsync --exclude-from.
#
# Everything NOT listed here is included by default.
# Add patterns for anything that should stay in the private repo.

# ── Pages (excluded from public) ──
apps/web/app/\(app\)/**
apps/web/app/api/**
apps/web/app/design-system/**
apps/web/app/example/**
apps/web/app/settings/**

# ── Design System components & config ──
apps/web/components/design-system-side-navigation.tsx
apps/web/components/mdx-components.tsx
apps/web/components/mobile-sidebar-sheet.tsx
apps/web/config/design-system-docs.ts

# ── Content & registry examples ──
apps/web/content/**
apps/web/contentlayer.config.js
apps/web/__registry__/**
apps/web/scripts/**
apps/web/public/r/**
apps/web/registry/default/examples/**

# ── DS-only static assets ──
apps/web/public/img/design-system-marks/**
apps/web/public/img/themes/**
apps/web/public/img/profile-images/**

# ── MDX / docs-only CSS ──
apps/web/styles/mdx.css
apps/web/styles/code-block-variables.css

# ── Local dev & linting ──
apps/web/supabase/**
apps/web/eslint.config.cjs

# ── Blocks (not used in public) ──
blocks/**

# ── Packages not needed for public ──
packages/icons/**
packages/eslint-config-webentic/**
packages/ui-patterns/**

# ── Old Supabase branding (not used) ──
packages/common/assets/images/archive/**
